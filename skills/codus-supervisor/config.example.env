# codus supervisor settings. Copy to ~/.codus-supervisor/config.env and edit.
# KEY=VALUE lines only; nothing here is executed. Environment variables with
# the same names win over this file.

# report: tell the user only (default).
# advise: also message other Brains (HOLD / ALLCLEAR / ROOM), rate-limited.
MODE=report

# How often the watcher samples, and how often it wakes the Brain anyway.
INTERVAL_SEC=60
TICK_MIN=60

# Agent status. Session written within BUSY_MIN minutes = busy.
# Nothing written for IDLE_MIN minutes and no CPU = idle.
BUSY_MIN=3
IDLE_MIN=30

# Capacity. macOS pressure level decides first; these add a floor on the
# memory the kernel reports as available.
FREE_TIGHT_PCT=20
FREE_CRIT_PCT=10

# Room estimate: keep this % of RAM free for browsers, builds and dev servers,
# halve the estimate when swap used passes SWAP_HEAVY_PCT of RAM, and never
# suggest more than MAX_EXTRA_AGENTS new agents at once.
RESERVE_PCT=30
SWAP_HEAVY_PCT=25
MAX_EXTRA_AGENTS=4
DEFAULT_AGENT_MB=300

# RECLAIM event: memory is not ok and idle agents hold at least this much.
RECLAIM_MB=1024
RECLAIM_COOLDOWN_MIN=60

# Advise mode. HOLD/ALLCLEAR go to one Brain at most once per COOLDOWN_MIN.
# ROOM nudges go to working Brains while at least ROOM_MIN more agents fit,
# every ROOM_EVERY_MIN minutes each; a Brain that runs
# `fleet-watch.sh --decline <its id>` is skipped for ROOM_DECLINE_MIN minutes.
COOLDOWN_MIN=60
ROOM_MIN=2
ROOM_EVERY_MIN=60
ROOM_DECLINE_MIN=60

# Quadrant lifecycle. A quadrant agent quiet for IDLE_MIN is reported as DONE
# (to its Brain in advise mode, and to you), at most once per DONE_EVERY_MIN.
# ON_BRAIN_CLOSE: when a Brain closes, `report` its leftover quadrants to you,
# or `free` them: stop their dev servers, unpin stopped ones, and close a tab
# only when everything in it belonged to that Brain and has finished.
DONE_EVERY_MIN=60
ON_BRAIN_CLOSE=report

# "Push harder" profile (Brains use every quadrant memory allows):
#   MODE=advise  MAX_EXTRA_AGENTS=8  RESERVE_PCT=20  ROOM_EVERY_MIN=5  ROOM_DECLINE_MIN=30
# Each nudge is a turn for the receiving Brain, which costs plan usage.

# Process names that count as agents.
AGENT_BINARIES=claude codex
